import { ButtonInteraction } from 'discord.js'
import { respond } from 'meocord/common'
import { Command, Controller } from 'meocord/decorator'
import { CommandType } from 'meocord/enum'

@Controller()
export class {{className}}ButtonController {
  // A button whose customId is {{commandName}}
  @Command('{{commandName}}', CommandType.BUTTON)
  async handle{{className}}(interaction: ButtonInteraction) {
    await respond(interaction).send({ content: 'Button clicked!' })
  }

  // A customId such as {{commandName}}/42 passes 42 as the id
  @Command('{{commandName}}/{id}', CommandType.BUTTON)
  async handle{{className}}WithId(interaction: ButtonInteraction, { id }: { id: string }) {
    await respond(interaction).send({ content: `Button with id ${id} clicked!` })
  }
}
