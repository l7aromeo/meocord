import { StringSelectMenuInteraction } from 'discord.js'
import { respond } from 'meocord/common'
import { Command, Controller } from 'meocord/decorator'
import { CommandType } from 'meocord/enum'

@Controller()
export class {{className}}SelectMenuController {
  // A menu whose customId is {{commandName}}
  @Command('{{commandName}}', CommandType.SELECT_MENU)
  async handle{{className}}(interaction: StringSelectMenuInteraction) {
    await respond(interaction).send({ content: `You picked ${interaction.values.join(', ')}.` })
  }
}
