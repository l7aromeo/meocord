import { RoleSelectMenuInteraction } from 'discord.js'
import { respond } from 'meocord/common'
import { Command, Controller } from 'meocord/decorator'
import { CommandType } from 'meocord/enum'

@Controller()
export class {{className}}RoleSelectMenuController {
  // A menu whose customId is {{commandName}}
  @Command('{{commandName}}', CommandType.ROLE_SELECT_MENU)
  async handle{{className}}(interaction: RoleSelectMenuInteraction) {
    await respond(interaction).send({ content: `Selected: ${interaction.roles.map(role => role.name).join(', ')}` })
  }
}
