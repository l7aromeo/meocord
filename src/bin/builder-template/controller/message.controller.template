import { MessageHandler, Controller } from 'meocord/decorator'
import { Message } from 'discord.js'
import { Logger } from 'meocord/common'

@Controller()
export class {{className}}MessageController {
  private readonly logger = new Logger({{className}}MessageController.name)

  // A message saying {{commandName}}, after the prefix @MeoCord({ messages }) sets, if any
  @MessageHandler('{{commandName}}')
  async handle{{className}}(message: Message): Promise<void> {
    try {
      await message.reply('Hello from {{commandName}}!')
    } catch (error) {
      this.logger.error('Error replying to the message', error)
    }
  }
}
