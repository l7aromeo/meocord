import { Pipe } from 'meocord/decorator'
import { type PipeInterface } from 'meocord/interface'
import { type ExecutionContext } from 'meocord/common'

@Pipe()
export class {{className}}Pipe implements PipeInterface<string, string> {
  // One instance serves every call: keep per-call state in local variables
