import { ChatInputCommandInteraction, MessageFlags } from 'discord.js'
import { Command, Controller, UseFilter } from 'meocord/decorator'
import { CommandType } from 'meocord/enum'
import { createMockInteraction, getResponse, MeoCordTestingModule } from 'meocord/testing'
import { {{className}}Error, {{className}}Filter } from './{{kebabCaseName}}.filter.js'

@Controller()
@UseFilter({{className}}Filter)
class SampleController {
  @Command('sample', CommandType.SLASH)
  async sample(_interaction: ChatInputCommandInteraction) {
    await Promise.reject(new {{className}}Error('Something needs your attention.'))
  }

  @Command('other', CommandType.SLASH)
  async other(_interaction: ChatInputCommandInteraction) {
    await Promise.reject(new Error('unrelated'))
  }
}

describe('{{className}}Filter', () => {
  const module = MeoCordTestingModule.create({ controllers: [SampleController] }).compile()

  it('answers the error privately, with its message', async () => {
    const interaction = createMockInteraction(ChatInputCommandInteraction)

    const { error } = await module.invoke(SampleController, 'sample', interaction)

    expect(error).toBeInstanceOf({{className}}Error)
    const [answer] = getResponse(interaction).calls
    expect(answer.payload).toMatchObject({ flags: MessageFlags.Ephemeral })
    expect(JSON.stringify(answer.payload)).toContain('Something needs your attention.')
  })

  it('leaves other errors to other filters', async () => {
    await expect(
      module.invoke(SampleController, 'other', createMockInteraction(ChatInputCommandInteraction)),
    ).rejects.toThrow('unrelated')
  })
})
