import { defineConfig } from 'vitest/config'
import swc from 'unplugin-swc'
import { fileURLToPath } from 'node:url'

export default defineConfig({
  // SWC rather than vite's esbuild: esbuild cannot emit decorator metadata, which the
  // dependency injection behind @Controller and @Service reads at runtime.
  plugins: [
    swc.vite({
      jsc: {
        parser: { syntax: 'typescript', decorators: true },
        transform: { legacyDecorator: true, decoratorMetadata: true },
        target: 'es2022',
      },
      module: { type: 'es6' },
    }),
  ],
  resolve: {
    alias: { '@src': fileURLToPath(new URL('./src', import.meta.url)) },
  },
  test: {
    globals: true,
    setupFiles: ['reflect-metadata'],
    clearMocks: true,
    include: ['src/**/*.spec.ts'],
    coverage: {
      // istanbul rather than v8: v8 coverage needs Node's inspector API, which bun does
      // not implement, and this template is expected to run under either runtime.
      provider: 'istanbul',
      include: ['src/**/*.ts'],
      // Naming `include` reports files no test imported, which is the point -- a controller
      // with no spec should show as zero rather than vanish from the percentage. Those files
      // are parsed by istanbul rather than transformed by swc, and that parser does not know
      // about decorators, so anything decorated but untested has to be excluded by hand.
      // app.ts is wiring rather than logic, and main.ts only boots the app.
      exclude: ['src/**/*.spec.ts', 'src/app.ts', 'src/main.ts'],
    },
  },
})
