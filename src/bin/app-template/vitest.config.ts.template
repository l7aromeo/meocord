import { defineConfig } from 'vitest/config'
import swc from 'unplugin-swc'
import { fileURLToPath } from 'node:url'

export default defineConfig({
  // SWC rather than vite's esbuild: esbuild cannot emit decorator metadata, which the
  // dependency injection behind @Controller and @Service reads at runtime.
  plugins: [
    swc.vite({
      jsc: {
        parser: { syntax: 'typescript', decorators: true },
        transform: { legacyDecorator: true, decoratorMetadata: true },
        target: 'es2022',
      },
      module: { type: 'es6' },
    }),
  ],
  resolve: {
    alias: { '@src': fileURLToPath(new URL('./src', import.meta.url)) },
  },
  test: {
    globals: true,
    setupFiles: ['./vitest.setup.ts'],
    // vi.fn() mocks only; vitest.setup.ts resets the mocks from meocord/testing
    clearMocks: true,
    include: ['src/**/*.spec.ts'],
    coverage: {
      // istanbul rather than v8: v8 coverage needs Node's inspector API, which bun does
      // not implement, and this template is expected to run under either runtime.
      provider: 'istanbul',
      include: ['src/**/*.ts'],
      // `include` reports untested files as zero rather than dropping them from the percentage.
      // istanbul parses those files without swc and cannot read decorators, so decorated files with no
      // spec are excluded; app.ts and main.ts only wire and boot the app, and declarations hold no code.
      exclude: ['src/**/*.spec.ts', 'src/**/*.d.ts', 'src/app.ts', 'src/main.ts'],
    },
  },
})
