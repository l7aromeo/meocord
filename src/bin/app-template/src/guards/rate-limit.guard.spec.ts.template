import { ButtonInteraction } from 'discord.js'
import { Command, Controller, UseGuard } from 'meocord/decorator'
import { CommandType } from 'meocord/enum'
import { createMockInteraction, createMockUser, MeoCordTestingModule, type TestingModule } from 'meocord/testing'
import { RateLimitGuard, requestTimes } from '@src/guards/rate-limit.guard.js'

@Controller()
class LimitedController {
  @Command('limited', CommandType.BUTTON)
  @UseGuard({ provide: RateLimitGuard, params: { limit: 2, windowInSeconds: 60 } })
  async handle(interaction: ButtonInteraction) {
    await interaction.deferUpdate()
  }
}

const createClick = (customId: string, userId: string) => {
  const user = createMockUser()
  user.id = userId
  return createMockInteraction(ButtonInteraction, { customId, user })
}

describe('RateLimitGuard', () => {
  let module: TestingModule

  beforeEach(() => {
    module = MeoCordTestingModule.create({ controllers: [LimitedController] }).compile()
  })

  // Each call resolves a new guard, so this fails unless the counts are shared between guard instances.
  it('blocks a user once the limit is reached across calls', async () => {
    const clicks = [1, 2, 3].map(() => createClick('limited', 'user-over-limit'))

    const ran: boolean[] = []
    for (const click of clicks) ran.push((await module.invoke(LimitedController, 'handle', click)).ran)

    expect(ran).toEqual([true, true, false])
    expect(clicks.map(click => click.deferUpdate.mock.calls.length)).toEqual([1, 1, 0])
  })

  it('counts each user separately', async () => {
    await module.invoke(LimitedController, 'handle', createClick('limited', 'user-a'))
    await module.invoke(LimitedController, 'handle', createClick('limited', 'user-a'))

    const { ran } = await module.invoke(LimitedController, 'handle', createClick('limited', 'user-b'))

    expect(ran).toBe(true)
  })

  it('allows a user again once the window has passed', async () => {
    vi.useFakeTimers()
    try {
      const guard = Object.assign(new RateLimitGuard(), { limit: 1, windowInSeconds: 60 })
      await guard.canActivate(createClick('windowed', 'user-c'))
      expect(await guard.canActivate(createClick('windowed', 'user-c'))).toBe(false)

      vi.advanceTimersByTime(60_000)

      expect(await guard.canActivate(createClick('windowed', 'user-c'))).toBe(true)
    } finally {
      vi.useRealTimers()
    }
  })

  it('forgets a user whose window has passed', async () => {
    vi.useFakeTimers()
    try {
      const guard = Object.assign(new RateLimitGuard(), { limit: 1, windowInSeconds: 60 })
      await guard.canActivate(createClick('expiring', 'user-d'))
      expect(requestTimes.has('expiring:user-d')).toBe(true)

      vi.advanceTimersByTime(60_000)
      await guard.canActivate(createClick('expiring', 'user-e'))

      expect(requestTimes.has('expiring:user-d')).toBe(false)
    } finally {
      vi.useRealTimers()
    }
  })
})
