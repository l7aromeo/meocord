import { Guard } from 'meocord/decorator'
import { type GuardInterface } from 'meocord/interface'
import { BaseInteraction } from 'discord.js'
import { Logger } from 'meocord/common'

// A new guard instance is created for every call, so the counts live at module level to be shared between them.
// In production, consider Redis or another store shared across processes.
export const requestTimes = new Map<string, { times: number[]; expiresAt: number }>()

@Guard()
export class RateLimitGuard implements GuardInterface {
  private logger = new Logger(RateLimitGuard.name)

  // Set per use with @UseGuard({ provide: RateLimitGuard, params: { limit, windowInSeconds } })
  limit = 5
  windowInSeconds = 60

  async canActivate(interaction: BaseInteraction): Promise<boolean> {
    const userId = interaction.user.id

    let key: string
    if (interaction.isChatInputCommand()) {
      const commandId = interaction.commandName
      const subCommand = interaction.options.getSubcommand(false) || ''
      key = subCommand ? `${commandId}:${subCommand}:${userId}` : `${commandId}:${userId}`
    } else if (interaction.isMessageComponent()) {
      key = `${interaction.customId}:${userId}`
    } else {
      key = userId
    }

    const currentTime = Math.floor(Date.now() / 1000)

    // Drop keys whose window has passed, so the map does not grow with every user it has seen
    for (const [storedKey, entry] of requestTimes) {
      if (entry.expiresAt <= currentTime) requestTimes.delete(storedKey)
    }

    const timestamps = requestTimes.get(key)?.times || []

    const filteredTimestamps = timestamps.filter(time => currentTime - time < this.windowInSeconds)
    filteredTimestamps.push(currentTime)
    requestTimes.set(key, { times: filteredTimestamps, expiresAt: currentTime + this.windowInSeconds })

    this.logger.debug(key, filteredTimestamps.length, this.limit, this.windowInSeconds)

    return filteredTimestamps.length <= this.limit
  }
}
