# Build output and lockfiles are generated; formatting them is churn.
dist
bun.lock

# TypeScript and JavaScript are formatted through eslint-plugin-prettier, which
# applies the same config with the project's lint rules alongside it.
*.ts
*.js
*.mjs
*.cjs

# Templates with no format of their own; prettier cannot infer a parser for them.
src/bin/app-template/_gitignore.template
src/bin/app-template/_env.example.template

# Generated by changesets at release time. The job that writes it cannot also format
# it, and an unformatted CHANGELOG would fail format:check on the release pull request.
CHANGELOG.md
