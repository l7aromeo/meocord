/.yarn/**            linguist-vendored
/.yarn/releases/*    binary
/.yarn/plugins/**/*  binary
/.pnp.*              binary linguist-generated

# The mark is compared byte for byte, here and by meocord/docs, so it is LF on every platform
tools/brand/mark.json text eol=lf

# Templates are written into new apps as they are, so a Windows checkout must not turn them into CRLF: a generated
# app is then byte for byte the same on every platform
src/bin/app-template/** text eol=lf
src/bin/builder-template/** text eol=lf
